{
  "mcpServers": {
    "templated": {
      "url": "https://metrics.example.com/mcp?api_key=${METRICS_API_KEY}"
    },
    "placeholder": {
      "url": "https://metrics.example.com/mcp?token=YOUR_TOKEN"
    },
    "plain-query": {
      "url": "https://metrics.example.com/mcp?region=eu-west-1&page=2"
    },
    "plain-wrapper": {
      "command": "sh",
      "args": ["-c", "exec node server.js"]
    },
    "download-not-run": {
      "command": "bash",
      "args": ["-c", "curl -o f https://example.com/x && sha256sum -c f.sum"]
    },
    "logical-or": {
      "command": "sh",
      "args": ["-c", "curl -fsS https://example.com/health || echo down"]
    },
    "download-to-jq": {
      "command": "sh",
      "args": ["-c", "curl -fsS https://example.com/health | jq ."]
    },
    "scoped-mount": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "-v", "/srv/data:/data", "img@sha256:0123"]
    },
    "bridge-network": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "--network=bridge", "img@sha256:0123"]
    },
    "not-privileged": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "--privileged=false", "img@sha256:0123"]
    }
  }
}
